# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────
# API do Data Hub (apps/api). Roda sob tsx (sem build step), como no churn_mvp.
# Credenciais entram por variáveis de ambiente da stack — nunca na imagem.
# ─────────────────────────────────────────────────────────────
# Base GLIBC (não Alpine/musl): o runtime de embeddings (onnxruntime-node, usado
# por @huggingface/transformers para a busca semântica/RAG) traz binários nativos
# glibc e NÃO roda em musl. bookworm-slim resolve isso. O modelo (~120MB) é
# baixado no 1º uso e cacheado no volume datahub-models (ver docker-compose.yml).
FROM node:22-bookworm-slim
WORKDIR /app

# libgomp1: dependência de runtime do onnxruntime-node (OpenMP).
# wget: usado pelo HEALTHCHECK (não vem no slim por padrão).
RUN apt-get update \
  && apt-get install -y --no-install-recommends libgomp1 wget \
  && rm -rf /var/lib/apt/lists/*

# Manifests do monorepo primeiro (cache de camada do npm ci).
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
RUN npm ci --omit=dev

# Código: API + tipos compartilhados (tsx resolve os imports .ts em runtime).
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

ENV NODE_ENV=production
ENV API_PORT=8790

EXPOSE 8790

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8790/api/health >/dev/null 2>&1 || exit 1

CMD ["npx", "tsx", "apps/api/src/index.ts"]
