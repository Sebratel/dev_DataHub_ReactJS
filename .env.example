# ─────────────────────────────────────────────────────────────
# Template de variáveis do Data Hub. Copie para `.env` e preencha.
# As credenciais das FONTES seguem o mesmo formato do churn_mvp.
# ─────────────────────────────────────────────────────────────

# ── Frontend (build do Vite) ─────────────────────────────────
VITE_GOOGLE_CLIENT_ID=

# ── Login por Firebase (recomendado) ──────────────────────────────────────
# Preenchido = o login usa Firebase Authentication: o SDK vai no bundle (nada
# baixado de accounts.google.com em tempo de execucao) e a API confere a
# assinatura do token localmente, com a chave publica do Google em cache. E o
# que mantem o login funcionando quando o firewall bloqueia o Google.
# Vazio = segue no Google Identity Services (comportamento anterior).
#
# Os valores saem de: console.firebase.google.com > Configuracoes do projeto >
# Seus apps > Configuracao do SDK. Nao sao segredo: ficam visiveis no bundle.
#
# ATENCAO, passo manual: no console do Firebase, em Authentication >
# Settings > Authorized domains, adicione o dominio onde o Data Hub roda.
# Sem isso o popup e recusado com auth/unauthorized-domain.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── API do hub ───────────────────────────────────────────────
API_PORT=8790
ALLOWED_DOMAIN=sebratel.com.br
# CSV de e-mails com papel admin no primeiro login.
ADMIN_EMAILS=

# ── Banco de METADADOS do hub (catálogo/usuários/dashboards) ─
DATAHUB_DB_HOST=localhost
DATAHUB_DB_PORT=5433
DATAHUB_DB_DATABASE=datahub
DATAHUB_DB_USER=datahub
DATAHUB_DB_PASSWORD=datahub-dev

# ── Ingestão (controle de carga — docs §9.1) ─────────────────
ETL_HOUR=3
SYNC_BATCH_SIZE=50000
SYNC_BATCH_PAUSE_MS=500

# ── Motor de consulta (DuckDB) — limites de proteção ─────────
# memory_limit da instância; threads; timeout (ms) das consultas interativas
# (explorador, preview de derivado, IA). Materialização/ingestão não têm timeout.
DUCK_MEMORY_LIMIT=2GB
DUCK_THREADS=4
DUCK_QUERY_TIMEOUT_MS=30000

# ── Fontes de dados (SOMENTE LEITURA — use usuário só-SELECT) ─
DB_ELLEVEN_HOST=
DB_ELLEVEN_DATABASE=
DB_ELLEVEN_USER=
DB_ELLEVEN_PASSWORD=
DB_ELLEVEN_PORT=

DB_RADIUS_HOST=
DB_RADIUS_DATABASE=
DB_RADIUS_USER=
DB_RADIUS_PASSWORD=
DB_RADIUS_PORT=

DB_MARIA_HOST=
DB_MARIA_DATABASE=
DB_MARIA_USER=
DB_MARIA_PASSWORD=
DB_MARIA_PORT=

DB_AUTOISP_HOST=
DB_AUTOISP_DATABASE=
DB_AUTOISP_USER=
DB_AUTOISP_PASSWORD=
DB_AUTOISP_PORT=

# ── Lake (GCS) e integrações legadas ─────────────────────────
BUCKET_GCP_NAME=
PATH_CREDENTIALS=
USER_SOAP=
PASSWORD_SOAP=
WSDL_URL=
WSDL_URL_DEMITIDOS=

# ── IA (módulo desacoplado — docs §12) ───────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# ── Google OAuth (backend) ───────────────────────────────────
GOOGLE_CLIENT_SECRET=
