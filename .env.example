# ─────────────────────────────────────────────────────────────
# Template de variáveis do Data Hub. Copie para `.env` e preencha.
# As credenciais das FONTES seguem o mesmo formato do churn_mvp.
# ─────────────────────────────────────────────────────────────

# ── Login por Firebase (OBRIGATORIO) ──────────────────────────────────────
# O unico login do Data Hub: o SDK vai no bundle (nada baixado de
# accounts.google.com em tempo de execucao) e a API confere a assinatura do
# token localmente, com a chave publica do Google em cache. E o que mantem o
# login funcionando quando o firewall bloqueia o Google.
#
# O login antigo (Google Identity Services, VITE_GOOGLE_CLIENT_ID) foi
# REMOVIDO (SEG-07, decisao D-SEG-5 do comite): a API aceitava um access token
# do Google sem conferir para qual aplicativo ele tinha sido emitido. Sem
# API_KEY, AUTH_DOMAIN e PROJECT_ID o deploy pelo docker-compose recusa subir.
#
# PROJETO PROPRIO DO DATA HUB. Convencao da casa: cada sistema tem o seu
# projeto Firebase de autenticacao -- nao se reaproveita o de outro setor
# (HUBBI, etc.). Assim a base de usuarios, os dominios autorizados, as cotas e
# o log de acesso de cada sistema ficam separados, e desligar um nao mexe nos
# outros.
#
# Os valores saem de: console.firebase.google.com > Configuracoes do projeto >
# Seus apps > Configuracao do SDK. Nao sao segredo: ficam visiveis no bundle.
#
# ATENCAO, passo manual: no console do Firebase, em Authentication >
# Settings > Authorized domains, adicione o dominio onde o Data Hub roda.
# Sem isso o popup e recusado com auth/unauthorized-domain.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── API do hub ───────────────────────────────────────────────
API_PORT=8790
ALLOWED_DOMAIN=sebratel.com.br
# CSV de e-mails com papel admin no primeiro login.
ADMIN_EMAILS=
# ADMIN MASTER — quem pode alterar COMO as FONTES atualizam (modo, chaves,
# identidade da linha, cadência e agendamento). Conjuntos CALCULADOS seguem
# liberados para admin/editor: eles rodam sobre o lake e não tocam fonte.
#
# Mora aqui, e não no banco, de propósito: o papel 'admin' é concedido pela
# própria tela de acessos, então qualquer admin poderia se promover. Esta lista
# só muda por deploy.
#
# Esta lista é a RAIZ DE CONFIANÇA: não é removível pela tela, e existe como
# caminho de recuperação. Outros masters podem ser concedidos sem deploy, em
# Usuários e Acessos › Admin master — mas só por quem já é master.
#
# Em branco = herda ADMIN_EMAILS. Se o ADMIN_EMAILS da stack tiver mais gente
# do que deveria mexer nas fontes, defina esta explicitamente. Com as duas
# vazias, e sem nenhum master concedido, NINGUÉM configura fonte e não há
# caminho de volta sem deploy — a API avisa isso no boot.
MASTER_ADMIN_EMAILS=

# ── Chave que cifra os segredos em repouso (OBRIGATÓRIA) ─────
# Cifra, no banco de metadados: as senhas das conexões cadastradas pela tela,
# as chaves dos provedores de IA e os segredos do gateway. AES-256-GCM.
#
# Guarde-a NO COFRE DE SENHAS, não só no Portainer. Se ela se perder, nada
# disso se lê de novo — não há recuperação, só recadastro. Já aconteceu: um
# redeploy deixou o campo em branco e 20 conjuntos ficaram três dias parados.
#
# Trocar a chave NÃO migra o que já está cifrado: os cadastros existentes
# passam a aparecer com a senha ilegível, e cada um precisa ser digitado de
# novo em Conexões.
#
# Gere com:  openssl rand -base64 32
CONNECTIONS_SECRET=

# ── Banco de METADADOS do hub (catálogo/usuários/dashboards) ─
DATAHUB_DB_HOST=localhost
DATAHUB_DB_PORT=5433
DATAHUB_DB_DATABASE=datahub
DATAHUB_DB_USER=datahub
DATAHUB_DB_PASSWORD=datahub-dev

# ── Ingestão (controle de carga — docs §9.1) ─────────────────
ETL_HOUR=3
SYNC_BATCH_SIZE=50000
SYNC_BATCH_PAUSE_MS=500
# Disjuntor anti-fuga: aborta a carga acima deste nº de linhas. 0 = sem limite.
SYNC_MAX_ROWS=0
# Teto de arquivos Parquet por conjunto antes de compactar mesmo sem ter nada a
# colapsar. A compactação (que reescreve o conjunto INTEIRO) só roda quando há
# identidade repetida; este teto evita que um conjunto em cadência de minutos
# acumule centenas de arquivinhos e deixe toda leitura mais lenta.
SYNC_COMPACT_MAX_PARTS=24
# Teto do DuckDB para UMA linha do JSONL de staging (uma linha da tabela). O
# padrão dele é 16 MB: uma linha maior derruba a conversão inteira, e uma
# tabela com coluna de texto grande passa disso com facilidade.
SYNC_MAX_JSON_OBJECT_BYTES=67108864
# A partir de quantos % de uso do volume do lake a tela avisa. O staging de uma
# carga grande é transitório mas pesado, então o pico passa bem do uso em
# repouso — 85 deixa margem para uma carga terminar antes de apertar.
SYNC_DISK_WARN_PERCENT=85

# ── Motor de consulta (DuckDB) — limites de proteção ─────────
# memory_limit da instância; threads; timeout (ms) das consultas interativas
# (explorador, preview de derivado, IA). Materialização/ingestão não têm timeout.
DUCK_MEMORY_LIMIT=2GB
DUCK_THREADS=4
DUCK_QUERY_TIMEOUT_MS=30000

# ── Fontes de dados (SOMENTE LEITURA — use usuário só-SELECT) ─
DB_ELLEVEN_HOST=
DB_ELLEVEN_DATABASE=
DB_ELLEVEN_USER=
DB_ELLEVEN_PASSWORD=
DB_ELLEVEN_PORT=

DB_RADIUS_HOST=
DB_RADIUS_DATABASE=
DB_RADIUS_USER=
DB_RADIUS_PASSWORD=
DB_RADIUS_PORT=

DB_MARIA_HOST=
DB_MARIA_DATABASE=
DB_MARIA_USER=
DB_MARIA_PASSWORD=
DB_MARIA_PORT=

DB_AUTOISP_HOST=
DB_AUTOISP_DATABASE=
DB_AUTOISP_USER=
DB_AUTOISP_PASSWORD=
DB_AUTOISP_PORT=

# ── Lake (GCS) e integrações legadas ─────────────────────────
BUCKET_GCP_NAME=
PATH_CREDENTIALS=
USER_SOAP=
PASSWORD_SOAP=
WSDL_URL=
WSDL_URL_DEMITIDOS=

# ── Databricks — publicação dos conjuntos (piloto Native/Matrix) ─────────
# O Data Hub consolida o Parquet do lake e ENVIA para um volume do Unity
# Catalog. O Databricks nunca alcança os bancos da Sebratel: a conexão é só de
# saída, por HTTPS. Ligar por conjunto é feito na tela de Conjuntos; esta
# variável é o freio geral e desliga tudo sem precisar de deploy.
DATABRICKS_SYNC_ENABLED=false
# Sem https:// e sem barra no fim.
DATABRICKS_HOST=
# Preferido: service principal (OAuth M2M), com permissão SÓ de escrita no
# volume de chegada. O PAT existe como atalho do piloto — rotacione no fim.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_TOKEN=
# Escopo do OAuth M2M. Tem que ser o MESMO com que o segredo foi emitido no
# console: pedir all-apis para um segredo de escopo restrito e recusado.
DATABRICKS_OAUTH_SCOPE=all-apis
# Em DESENVOLVIMENTO use .../arquivos/_dev: o job de carga ignora pastas que
# começam com '_', então teste de desenvolvedor nunca vira tabela.
DATABRICKS_VOLUME_PATH=/Volumes/piloto_mariadb/landing/arquivos
DATABRICKS_UPLOAD_TIMEOUT_SECONDS=300
DATABRICKS_UPLOAD_MAX_RETRIES=5
# Acima disto o consolidado é dividido em partes. O teto da Files API é 5 GB.
DATABRICKS_MAX_PART_BYTES=536870912
# Fuso em que o lake gravou os timestamps (eles não têm fuso embutido). É o que
# a conversão para UTC assume — errar aqui desloca todo horário, em silêncio.
DATABRICKS_SOURCE_TZ=America/Sao_Paulo

# Raiz de armazenamento do catalogo no Unity Catalog, usada so pelo comando
# `npm run databricks:setup-catalog` (ex.: s3://bucket/caminho ou
# abfss://container@conta.dfs.core.windows.net/caminho). Vazia = o catalogo
# usa o metastore padrao do workspace.
DATABRICKS_CATALOG_STORAGE_ROOT=

# ── IA (módulo desacoplado — docs §12) ───────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
